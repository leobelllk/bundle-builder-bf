{{ 'component-bundle-card.css' | asset_url | stylesheet_tag }}
{{ 'component-bundle-section.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}

{% liquid
  assign variants_available_arr = collections['bundle-products'].products | map: 'available'
%}

{% assign discount_images = 'https://cdn.shopify.com/s/files/1/0837/5153/4895/files/discount-5.png?v=1730776254,https://cdn.shopify.com/s/files/1/0837/5153/4895/files/discount-10.png?v=1730776254,https://cdn.shopify.com/s/files/1/0837/5153/4895/files/discount-15.png?v=1730776253,https://cdn.shopify.com/s/files/1/0837/5153/4895/files/discount-20.png?v=1730776253' | split: ',' %}

    <div class="bundle page-width">
      <div class="column-dp halfside">
          <div class="bundle_titles">
      <h2>Selecione os produtos</h2>
      <div class="low-stock">• &nbsp<en>ESTOQUE BAIXO:</en>
        &nbspLorem ipsum dolor sit amet</div>
      <p class="discounttext">Adicione produtos e desbloqueie os descontos</p>
    </div>
      <div class="preview-products page-width">
        {% for i in (1..4) %}
          <div class="preview-product-wrapper">
            <div class="sale-tag">{{ forloop.index | times: 5 }}% OFF</div>
            <div class="preview-product" id="preview-{{ forloop.index }}">
              <div class="preview-image-wrapper">
                <img class="preview-image" src="{{ discount_images[forloop.index0] }}">
              </div>
              <div class="locker-icon">
                {{- 'icon-locker.svg' | inline_asset_content -}}
              </div>
              {% if forloop.last %}
                <p class="frete">
                  + Frete Grátis
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <ul class="bundle-products-wrapper page-width">
        {% for product in collections['bundle-products'].products %}
          {% liquid
            assign option_disabled = true
            if variants_available_arr[forloop.index0]
              assign option_disabled = false
            endif
          %}
          {% render 'bundle-card'
            , product: product
            , option_disabled: option_disabled
            , index: forloop.index0 %}
        {% endfor %}
      </ul>

        <div class="ingredients">
          <p class="ingredients-table" id="ingredients" onclick="openPopup()">Confira a tabela e os ingredientes</p>
        </div>
      </div>

      <div class="popup-background" id="popup-background"></div>
    
    <div class="popup" id="popup">
        <span class="popup-close" onclick="closePopup()">X</span>
        <img src="https://cdn.shopify.com/s/files/1/0837/5153/4895/files/image_1.png?v=1730842841" alt="Image">
    </div>

      <div class="column-dp halfside">
        <div class="bundle-cart-wrapper">
          <div class="resume-title">
            <h2></h2>
          </div>
          <div class="resume-content">
          <ul class="selected-bundle-products"></ul>
            <div class="button-adjust">
          <button
            class="button button--primary"
            id="add-bundle-products"
            type="button">CHECKOUT</button>
            </div>
            <div class="guarantee">
              <img class="guarantee-image" src="https://cdn.shopify.com/s/files/1/0837/5153/4895/files/660ec869595882acf534980b_selo-garantia_svg.png?v=1730860728">
              <p class="guarantee-text"><en>Experimente por 30 dias.</en> Se você não estiver totalmente apaixonado pelo produto, reembolsaremos 100% do valor.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mobile-sticky-button">
<div class="sticky-button page-width">
  <div class="sticky-content">
    <div class="sticky-fc">
      <div class="sticky-disc">
        
      </div>
      <div class="sticky-price">
        
      </div>
    </div>
    <div class="sticky-sc">
      <p class="total-disc"></p>
      <div class="sticky-cta">
        SELECIONAR PRODUTOS
      </div>
    </div>
  </div>
  <div class="low-stock">• &nbsp<en>ESTOQUE BAIXO:</en> &nbspLorem ipsum dolor sit amet</div>
</div>
</div>

<div class="popup-overlay" style="display: none;">
  <div class="popup-content">
    <div class="choose-options">
      <!-- Variantes serão adicionadas dinamicamente aqui -->
    </div>
    <button class="close-popup">X</button>
  </div>
</div>

<script>
  const productsData = {
    {% for product in collections['bundle-products'].products %}
      "{{ product.handle }}": {
        id: {{ product.id }},
        variants: [{% for variant in product.variants %}{ id: {{ variant.id }}{% unless product.has_only_default_variant %}, options: [{% for option in variant.options %}"{{ option }}"{%- unless forloop.last -%}, {%- endunless -%}{% endfor %}]{% endunless %} }{% unless forloop.last %}, {% endunless %}{% endfor %}],
        options: [{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}{ name: "{{ option.name }}", values: [{% for value in option.values %}"{{ value }}"{% unless forloop.last %}, {% endunless %}{% endfor %}] }{% unless forloop.last %}, {% endunless %}{% endfor %}{% endunless %}],
        title: "{{ product.title }}",
        price: {{ product.price }},
        category: "{{ product.category }}",
        image: "{{ product.featured_image | image_url: width: 200 }}"
      },
    {% endfor %}
  };

  function findBeveragePrice(productsData) {
    const productsArray = Object.values(productsData);
    const beverageProduct = productsArray.find(product => product.category === "Bebidas em pó" || product.category === 'Vitaminas e suplementos' );
    return beverageProduct.price;
  }
  
  const beveragePrice = findBeveragePrice(productsData);
  const sticksPerBox = 14;

  document.addEventListener('DOMContentLoaded', function() {
    let selectedProducts = []; // Armazena os IDs dos produtos e suas imagens associadas
    let selectedProductsQty = []; // Armazena os IDs dos produtos e suas quantidades associadas
    const inputs = document.querySelectorAll('.bundle-card .quantity__input');
    const productWrapper = document.querySelectorAll('.bundle-card:not(:has(.open-popup))');
    const productVariantsWrapper = document.querySelectorAll('.bundle-card:has(.open-popup)');
    const includeButtons = document.querySelectorAll('.open-popup .include');
    const removeButtons = document.querySelectorAll('.open-popup .remove');
    const popupOverlay = document.querySelector('.popup-overlay');
    const chooseOptionsContainer = document.querySelector('.choose-options');
    const closePopupButton = document.querySelector('.close-popup');
    let selectedOptions = [];

    // Formata número para dinheiro
    function moneyFormat(price) {
      return price.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // Função para reverter formatação de dinheiro para número
    function moneyToNumber(price) {
      return Number(price.replace('R$', '').replace('.', '').replace(',', '.'));
    }

    // Retorna o índice do último produto que corresponde ao ID
    function findLastProductIndex(productsArray, id) {
      for (let i = productsArray.length - 1; i >= 0; i--) {
        if (productsArray[i].id === id) {
          return i;
        }
      }
      return -1;
    }

    // Função para atualizar as imagens dos previews de produtos selecionados
    function updatePreviewImages() {
      const preview_images = document.querySelectorAll('.preview-product');

      preview_images.forEach(preview => {
        preview.classList.remove('active');
      });

      selectedProducts.forEach((produto, index) => {
        if(index < 4) {
          preview_images[index].classList.add('active');
        }
      });
    }

    // Função para atualizar a lista de produtos selecionados e os preços dos cards
    function updateSelectedProductsList() {
      const selectedProductsList = document.querySelector('.selected-bundle-products');
      selectedProductsList.innerHTML = '';
      
      const qty = selectedProducts.length;
      let discount = 1;

      switch (qty) {
        case 1:
          discount = 0.95; // 5% de desconto
          break;
        case 2:
          discount = 0.90; // 10% de desconto
          break;
        case 3:
          discount = 0.85; // 15% de desconto
          break;
        default:
          if (qty >= 4) {
            discount = 0.80; // 20% de desconto para 4 itens ou mais
          }
          break;
      }
      if (qty <= 4) {
        const discountedPrices = document.querySelectorAll('.discounted-price');
        const regularPrices = document.querySelectorAll('.bundle-regular-price');
        
        discountedPrices.forEach(discountedPrice => {
          let regularPrice = discountedPrice.dataset.price;
          discountedPrice.innerText = moneyFormat(regularPrice*discount/100);
        });

        if(qty > 0) {
          regularPrices.forEach(regularPrice => {
            regularPrice.classList.remove('visually-hidden');
          });
        } else {
          regularPrices.forEach(regularPrice => {
            regularPrice.classList.add('visually-hidden');
          });
        }
      }

      let totalPrice = 0;
      let totalDiscountedPrice = 0;

      // Adiciona a quantidade, o título e o preço sem desconto e com desconto de cada produto selecionado
      selectedProductsQty.forEach(item => {
        const product = productsData[item.handle];
        const regularPrice = (item.quantity*product.price/100);
        const discountedPrice = (discount*item.quantity*product.price/100);
        totalPrice += regularPrice;
        totalDiscountedPrice += discountedPrice;
        
        const listItem = document.createElement('li');
        listItem.innerHTML = `
          <div class="bundle-cart-item-qty">
            ${item.quantity}x
          </div>
          <div class="bundle-cart-item-info">
            <span>${product.title}${item.options ? ` - ${item.options}` : ''}</span>
          </div>
          <div class="bundle-cart-item-price">
            <s>${moneyFormat(regularPrice)}</s>
            ${moneyFormat(discountedPrice)}
          </div>
        `;
        selectedProductsList.appendChild(listItem);
      });

      // Adiciona div com preço por stick e preço total se quantidade de produtos selecionados > 0
      if(qty > 0) {
        const price_per_unit = document.createElement('div');
        price_per_unit.className = 'total-resume';
        if(qty > 3) {
        price_per_unit.innerHTML = `
          <div class="dinamic-discount">
          <span>Você ganhou ${((1 - discount)*100).toFixed(0)}% OFF + Frete Grátis</span>
          </div>
          <div class="bundle-cart-price">
            ${moneyFormat(beveragePrice*discount/(100*sticksPerBox))} por stick
            <div class="bundle-total-price">
              <s>${moneyFormat(totalPrice)}</s>
              ${moneyFormat(totalDiscountedPrice)}
            </div>
          </div>
        `;
          }
        else {
          price_per_unit.innerHTML = `
          <div class="dinamic-discount">
          <span>Você ganhou ${((1 - discount)*100).toFixed(0)}% OFF</span>
          </div>
          <div class="bundle-cart-price">
            ${moneyFormat(beveragePrice*discount/(100*sticksPerBox))} por stick
            <div class="bundle-total-price">
              <s>${moneyFormat(totalPrice)}</s>
              ${moneyFormat(totalDiscountedPrice)}
            </div>
          </div>
        `;
        }
        selectedProductsList.appendChild(price_per_unit);
      }
      
      if (qty > 3 ){
      document.querySelector('.sticky-disc').innerHTML = `${((1 - discount) * 100).toFixed(0)}% + <br>Frete Grátis`; 
        }
      else {
        document.querySelector('.sticky-disc').innerText = `${((1 - discount) * 100).toFixed(0)}%`; 
      }
      document.querySelector('.sticky-price').innerHTML = `<s>${moneyFormat(totalPrice)}</s> ${moneyFormat(totalDiscountedPrice)}`; 
      document.querySelector('.total-disc').innerText = `Economizou: ${moneyFormat(totalPrice - totalDiscountedPrice)}`;

      if (qty > 0) {
        if (isMobile()) {
            window.addEventListener('scroll', function() {
                const button = document.querySelector('.mobile-sticky-button');
                const scrollPosition = window.scrollY + window.innerHeight;
                const documentHeight = document.documentElement.scrollHeight;

                if (window.scrollY > 200 && scrollPosition < documentHeight) { // Altere o valor 300 para a altura desejada
                    button.classList.add('active');
                } else {
                    button.classList.remove('active');
                }
            });
        }
          }

            if (qty > 0 ) {
      document.querySelector('.resume-title h2').innerText = `Carrinho de Compras`;
      }
      else {
        document.querySelector('.resume-title h2').innerText = `Selecione pelo menos 1 produto`;
      }
    }

    // Adicionar produto quando clicar no +
    const quantity_plus = document.querySelectorAll('.quantity__plus');
    quantity_plus.forEach((plus, i) => {
      plus.addEventListener('click', () => {
        productWrapper[i].classList.remove('not-chosen');
        const productHandle = plus.dataset.handle;
        const product = productsData[productHandle];
        
        selectedProducts.push({
          id: product.variants[0].id,
          handle: productHandle
        });

        updatePreviewImages();

        const existingProduct = selectedProductsQty.find(element => element.id === product.variants[0].id);

        if (existingProduct) {
          existingProduct.quantity += 1;
        } else {
          selectedProductsQty.push({
            id: product.variants[0].id,
            quantity: 1,
            handle: productHandle
          });
        }

        updateSelectedProductsList();
      });
    });

    // Remover produto quando clicar no -
    const quantity_minus = document.querySelectorAll('.quantity__minus');
    quantity_minus.forEach((minus, i) => {
      minus.addEventListener('click', () => {
        if(inputs[i].value < 1) {
          productWrapper[i].classList.add('not-chosen');
        }
        
        const productHandle = minus.dataset.handle;
        const product = productsData[productHandle];

        const productIndex = findLastProductIndex(selectedProducts, product.variants[0].id);
        if (productIndex !== -1) {
          selectedProducts.splice(productIndex, 1);
        }

        updatePreviewImages();

        const existingProduct = selectedProductsQty.find(element => element.id === product.variants[0].id);
        
        if(!existingProduct) {
          return;
        }

        if (existingProduct.quantity > 1) {
          existingProduct.quantity -= 1;
        } else {
          const indexToRemove = selectedProductsQty.findIndex(element => element.id === product.variants[0].id);  
          selectedProductsQty.splice(indexToRemove, 1);
        }

        updateSelectedProductsList();
      });
    });

    // Função para abrir o popup e exibir as variantes do produto
    includeButtons.forEach((include, index) => {
      include.addEventListener('click', function() {
        const productHandle = this.dataset.handle;
        const product = productsData[productHandle];

        if (product) {
          popupOverlay.style.display = 'flex';
          chooseOptionsContainer.innerHTML = '';
          const variantSelects = document.createElement('variant-selects');
          variantSelects.id = `variant-selects-${product.id}`;
          variantSelects.dataset.section = product.id;

          // Adiciona a imagem do produto no topo da popup
          const productImage = document.createElement('img');
          productImage.classList.add('popup-product-image');
          productImage.src = product.image;
          productImage.alt = product.title;

          chooseOptionsContainer.appendChild(productImage);
          chooseOptionsContainer.appendChild(variantSelects);

          // Criar campos de opções dinâmicos
          product.options.forEach((option, index) => {
            const optionFieldset = document.createElement('fieldset');
            optionFieldset.classList.add('js', 'product-form__input', 'product-form__input--pill');

            const optionLabel = document.createElement('legend');
            optionLabel.classList.add('form__label');
            optionLabel.innerText = option.name;

            optionFieldset.appendChild(optionLabel);
            variantSelects.appendChild(optionFieldset);

            option.values.forEach((value, idx) => {
              const optionInput = document.createElement('input');
              optionInput.type = 'radio';
              optionInput.name = `${option.name}-${index}`;
              optionInput.value = value;
              optionInput.id = `${product.id}-${index}-${idx}`;

              // Define o primeiro option como checked
              if (idx === 0) {
                optionInput.checked = true;
                selectedOptions[index] = value;
              }

              optionInput.addEventListener('change', () => {
                selectedOptions[index] = value;
                
                const filteredVariants = product.variants.filter(variant => variant.options.indexOf(value) != -1);
                const fieldsets = chooseOptionsContainer.querySelectorAll('fieldset');
                fieldsets.forEach((fieldset, i) => {
                  if (i > index) {
                    const availablesOptions = filteredVariants.map(variant => variant.options[i]);
                    const inputs = fieldset.querySelectorAll('input');
                    inputs.forEach(input => {
                      if(availablesOptions.indexOf(input.value) == -1) {
                        input.disabled = true;
                      } else {
                        input.disabled = false;
                      }
                    });
                  }
                });

                const matchingVariant = product.variants.find(variant => {
                  return variant.options.every((optionValue, index) => {
                    return selectedOptions[index] === optionValue;
                  });
                });    

                if(!matchingVariant) {
                  addVariantButton.disabled = true;
                } else {
                  addVariantButton.disabled = false;
                }
              });

              const optionLabel = document.createElement('label');
              optionLabel.htmlFor = `${product.id}-${index}-${idx}`;
              optionLabel.innerText = value;

              optionFieldset.appendChild(optionInput);
              optionFieldset.appendChild(optionLabel);
            });
          });

          const addVariantButton = document.createElement('button');
          addVariantButton.classList.add('chose-size-popup')
          addVariantButton.innerText = 'Selecionar tamanho';

          addVariantButton.addEventListener('click', function() {
            // Localizar a variante correspondente
            const matchingVariant = product.variants.find(variant => {
              return variant.options.every((optionValue, index) => {
                return selectedOptions[index] === optionValue;
              });
            });

            if (matchingVariant) {
              // Adicionar variante ao selectedProducts e selectedProductsQty
              const existingProduct = selectedProductsQty.find(item => item.id === matchingVariant.id);

              if (!existingProduct) {
                selectedProducts.push({ id: matchingVariant.id, handle: productHandle, image: product.image });
                selectedProductsQty.push({
                  id: matchingVariant.id,
                  quantity: 1,
                  handle: productHandle,
                  options: matchingVariant.options
                });
                productVariantsWrapper[index].classList.remove('not-chosen');
              }

              updatePreviewImages();
              updateSelectedProductsList();
            } else {
              alert('Nenhuma variante correspondente encontrada');
            }

            // Fechar o popup
            popupOverlay.style.display = 'none';
          });

          chooseOptionsContainer.appendChild(addVariantButton);
        }
      });
    });

    // Remover o produto com variantes
    removeButtons.forEach((remove, index) => {
      remove.addEventListener('click', function() {
        const productHandle = this.dataset.handle;
        // Verifica se o produto existe nas arrays antes de remover
        const productIndex = selectedProducts.findIndex(product => product.handle === productHandle);
        const qtyIndex = selectedProductsQty.findIndex(product => product.handle === productHandle);

        // Se o produto for encontrado, remove das arrays
        if (productIndex !== -1) {
          selectedProducts.splice(productIndex, 1);
        }

        if (qtyIndex !== -1) {
          selectedProductsQty.splice(qtyIndex, 1);
        }

        productVariantsWrapper[index].classList.add('not-chosen');

        // Atualizar visualizações e lista de produtos
        updatePreviewImages();
        updateSelectedProductsList();
      });
    });

    // Fechar o popup ao clicar no botão Fechar
    closePopupButton.addEventListener('click', function() {
      popupOverlay.style.display = 'none';
    });

    // Adicionar produtos ao carrinho
    document.getElementById('add-bundle-products').addEventListener('click', function() {
      const data = {
        items: selectedProductsQty
      };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      })
      .then(response => response.json())
      .then(cart => {
        console.log('Cart updated:', cart);
      })
      .catch(error => {
        console.error('Error adding products to cart:', error);
      });
    });
  });

        function openPopup() {
            document.getElementById('popup-background').style.display = 'block';
            document.getElementById('popup').classList.add('show');
        }

        function closePopup() {
            document.getElementById('popup-background').style.display = 'none';
            document.getElementById('popup').classList.remove('show');
        }

        function isMobile() {
            return window.innerWidth <= 768; // Define uma largura máxima para dispositivos móveis (ajustável)
        }

</script>

{% schema %}
  {
    "name": "Bundle Black Friday",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Bundle products collection"
      }
    ]
  }
{% endschema %}
