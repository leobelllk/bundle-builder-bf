<style>
  .video-container {
    display: flex;
  }

  .light {
    font-weight: 300;
  }

  .plyr_video {
    width: 100%;
    object-fit: cover;
  }

  .video-content-reviews {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .content-review {
    font-size: 12px;
    font-weight: 600;
  }

  .change-text {
    transition: opacity 0.5s ease-in-out;
    opacity: 1; /* Garantir que o elemento comece visível */
}

  .btn-primary-rewind,
  .btn-secondary-rewind{
    cursor: pointer;
  }

  @media screen and (min-width: 1800px) {
              .video-content-container {
         left: 25% !important;
       }
  }

  @media screen and (min-width: 1440px) {
          .video-content-container {
         left: 15%;
       }
  }

  @media screen and (min-width: 1024px) and (max-width: 1439px) {
              .video-content-container {
         left: 10%;
       }
  }

     @media screen and (min-width: 768px) and (max-width: 1024px) {
       .video-content-container {
         left: 5%;
       }
  }

  @media screen and  (min-width: 768px) {

    .plyr_video {
      height: 800px;
    }

    .video-content-container {
      position: absolute;
      z-index: 1;
      padding-top: 250px;
      display: flex;
      flex-direction: column;
    }

    .content-title,
    .content-text,
    .content-review {
      color: white;
    }

    .content-title {
      font-size: 50px;
    }

    .content-text {
      padding-top: 20px;
      padding-bottom: 50px;
    }

    .btn-primary-rewind {
      background: #9BDB20;
    padding: 20px 30px;
    border-radius: 100px;
    color: black;
    font-weight: 500;
       border: 0.2rem solid #9BDB20;
    }

    .btn-secondary-rewind {
      background: transparent;
      padding: 20px 30px;
      border-radius: 100px;
      color: white;
      font-weight: 500;
      border: 0.2rem solid white;
    }

    .video-content-reviews.mobile {
      display: none;
    }

      .video-content-reviews {
    padding-top: 50px;
  }

    .video-section {
      position: relative;
    }
    
  }

  @media screen and (max-width: 767px) {
    .video-player {
      display: flex;
      flex-direction: column-reverse;
      margin-top: -50px
    }

    .video-section {
      z-index: 10;
      margin-top: -220px;
    }

    .btn-fullw {
      width: 100%;
    }

    .video-content-container {
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 15px;
      background: #f8f6f3;
    }

    .video-content-buttons {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .content-title {
      font-size: 30px;
    }

    .content-text {
      font-size: 14px;
      padding: 0 15px 15px 15px;
    }

    .video-content-title {
      padding: 15px 15px 0 15px;
    }

    .video-content-title,
    .content-text {
      text-align: center;
    }

    .plyr_video {
      height: 500px;
    }

    .btn-primary-rewind {
      background: #9BDB20;
    padding: 20px 30px;
    border-radius: 100px;
    color: black;
      font-size: 16px;
    font-weight: 500;
       border: 0.2rem solid #9BDB20;
    }

    .btn-secondary-rewind {
      background: transparent;
      padding: 20px 30px;
      border-radius: 100px;
      color: black;
      font-size: 16px;
      font-weight: 500;
      border: 0.2rem solid black;
    }

    .video-content-reviews.dekstop {
      display: none;
    }

    .video-content-reviews {
    display: flex;
    justify-content: center;
  }
  }
  
</style>

<script>
  
  document.addEventListener('DOMContentLoaded', function () {
    const texts = ["ir mais longe.", "ter mais energia.", "viver mais."];
    const changeTextElement = document.querySelector('.change-text');
    let index = 0;

    function changeText() {
        // Fade out
        changeTextElement.style.opacity = 0;

        setTimeout(function () {
            // Mudar o texto após o fade out
            changeTextElement.textContent = texts[index];
            index = (index + 1) % texts.length;

            // Fade in
            changeTextElement.style.opacity = 1;
        }, 500); // 500ms para o fade out
    }

    setInterval(changeText, 2500); // Troca a cada 4 segundos
});

</script>

